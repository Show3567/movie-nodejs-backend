		"build:dev": "npx cross-env NODE_ENV=development tsc && copyfiles -u 1 src/**/*.pem dist",
		"start:dev": "npx cross-env NODE_ENV=development node dist/app.js",
		"serve:pm2": "pm2 start dist/app.js --name movie-nodejs-backend --watch",
		"remove:pm2": "pm2 delete movie-nodejs-backend"
	},
